# Copy to .env.local for local dev. Set the same keys in Render (Environment tab).

# PayPal sandbox REST app — developer.paypal.com > Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app's Webhooks section (needed only on the deployed site)
PAYPAL_WEBHOOK_ID=

# Anthropic API key — console.anthropic.com
ANTHROPIC_API_KEY=
# Optional override; default claude-sonnet-5-5
ANTHROPIC_MODEL=

# Channel3 — trychannel3.com/developers (promo code PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=

# Local Postgres (docker run ... -p 5433:5432 postgres:17-alpine)
DATABASE_URL=postgres://leash:leash@localhost:5433/leash

# Public base URL used for PayPal return/cancel redirects
APP_URL=http://localhost:3000

# Max agent runs per visitor workspace (protects the public demo's AI bill)
MAX_RUNS_PER_WORKSPACE=15
