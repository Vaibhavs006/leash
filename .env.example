# Leash configuration. Copy to .env.local for local dev:  cp .env.example .env.local
# Set the same keys in Render (Environment tab) for the deployed site.
#
# Every integration is optional. Any integration without keys runs as a clearly
# labelled OFFLINE SIMULATOR (see DEMO_MODE below), so the app always starts.

# ── PayPal sandbox (payments) ──────────────────────────────────────────────
# developer.paypal.com → log in → Apps & Credentials → make sure "Sandbox" is selected
# → Create App (type: Merchant) → copy Client ID and Secret.
# In the app's settings, under "Accept payments" → Advanced options, enable "Vault".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only for the deployed site: same app → Webhooks → Add webhook → copy its "Webhook ID".
PAYPAL_WEBHOOK_ID=

# ── Anthropic (the AI agent) ───────────────────────────────────────────────
# console.anthropic.com → Settings → API keys → Create key.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=

# ── Channel3 (product search) ──────────────────────────────────────────────
# trychannel3.com/developers → sign up → copy the API key from the dashboard.
# Hackathon promo code for 20,000 free searches: PAYPAL-HACKATHON-2026
CHANNEL3_API_KEY=

# ── Database ───────────────────────────────────────────────────────────────
# Local Postgres from the docker command in the README (note port 5433).
DATABASE_URL=postgres://leash:leash@localhost:5433/leash

# ── App ────────────────────────────────────────────────────────────────────
# Public base URL used for PayPal return/cancel redirects. On Render this falls
# back to RENDER_EXTERNAL_URL automatically.
APP_URL=http://localhost:3000

# auto (default): integrations without keys use the offline simulators.
# off: integrations without keys are disabled (their features return 503).
DEMO_MODE=auto

# Max LIVE (Claude) agent runs per visitor workspace; protects the public demo's AI bill.
MAX_RUNS_PER_WORKSPACE=15
