{
  "name": "leash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "spike:paypal": "tsx scripts/paypal-spike.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:int": "VITEST_INTEGRATION=1 vitest run --fileParallelism=false",
    "check:channel3": "tsx scripts/channel3-check.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.98",
    "ai": "^7.0.164",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
